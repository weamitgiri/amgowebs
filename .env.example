APP_NAME="Webveo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL 8+) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webnew_cms
DB_USERNAME=webnew
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production over HTTPS, set this to true:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail ----
# Dev: "log" writes emails to storage/logs. Production: set SMTP below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@webveo.example"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Initial admin account (used ONCE by the database seeder) ----
# Change these before first `php artisan db:seed`, then change the password in-app.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@webveo.example"
ADMIN_PASSWORD="change-this-strong-password"

# ---- Public site defaults (editable later in admin → Settings) ----
# SITE_BRAND_NAME is the placeholder brand seeded into Settings → change it in-app anytime.
SITE_BRAND_NAME="Webveo"
SITE_DEFAULT_CURRENCY=USD
SITE_SUPPORT_EMAIL="hello@webveo.example"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
